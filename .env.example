# compose가 읽는 환경 변수 목록. 복사해서 값을 채운다: cp .env.example .env
# .env는 커밋하지 않는다

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 로그인 토큰(JWT) 서명 키. 32자 이상의 무작위 문자열 (예: openssl rand -base64 48)
JWT_SECRET=

# AI 분석 서버(analysis-server)는 같은 compose에서 함께 뜨고, 백엔드가 서비스 이름(analysis)으로 부른다
# 내부 토큰은 백엔드와 분석 서버가 같이 쓰는 32자 이상 문자열 (예: openssl rand -base64 48)
# Anthropic API 키는 이 서비스 전용으로 발급하고, 콘솔에서 월 지출 한도를 설정한다. 서버 .env에만 두고 커밋하지 않는다
# 서버(compose.prod.yaml)는 두 값이 모두 있어야 뜬다. 로컬(compose.yaml)은 비우면 AI 기능만 503이고 나머지는 그대로 뜸
ANALYSIS_INTERNAL_TOKEN=
ANALYSIS_ANTHROPIC_API_KEY=

# 출금 계좌·예금주 암호화 키. Base64로 인코딩한 32바이트 (예: openssl rand -base64 32)
CASHOUT_ACCOUNT_CRYPTO_KEY

# 소셜 로그인(OAuth) 앱 값. Google Cloud Console·GitHub OAuth App에서 받는다. 비우면 소셜 로그인만 실패한다
# 돌아올 주소: <사이트 주소>/auth/callback/google, <사이트 주소>/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 구독 현금 결제(카카오페이·토스 테스트). 비우면 해당 결제 수단만 "지금은 쓸 수 없어요"로 막히고 나머지는 그대로 뜬다
# 테스트 키만 넣는다. 운영 키·운영 CID는 넣지 않는다(실제 돈이 빠질 수 있다)
# 카카오페이: 카카오페이 디벨로퍼스(developers.kakaopay.com) > 애플리케이션 > 발급정보의 Dev Secret Key와 테스트 CID(TC0ONETIME).
#   그 앱의 플랫폼 > Web > 사이트도메인에 결제 뒤 돌아올 주소의 도메인(예: http://localhost:3005)을 등록해야 한다
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=TC0ONETIME
# 토스: 토스페이먼츠 개발자센터 > API 키의 "API 개별 연동 키" 테스트 키. 클라이언트 키는 test_ck_…, 시크릿 키는 test_sk_…
TOSSPAYMENTS_CLIENT_KEY=
TOSSPAYMENTS_SECRET_KEY=
# 결제 뒤 돌아올 사이트 주소. 로컬은 비우면 NEXT_PUBLIC_SITE_URL을 쓴다. 서버(compose.prod.yaml)는 사이트 주소를 넣는다
# PAYMENT_RETURN_BASE_URL=

# 프론트 동작 모드. 없으면 backend(실제 백엔드), 목업으로 띄우려면 주석을 푼다
# compose.yaml에서만 쓰고, 서버의 compose.prod.yaml은 항상 backend다
# AUTH_MODE=mock

# 프론트 이미지를 빌드할 때 들어가는 접속 주소 (예: http://localhost:3005)
# compose.yaml, compose.override.yaml에서 쓴다
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# GHCR 이미지 주소의 소유자 (ghcr.io/<GITHUB_OWNER>/test-moa-*). 소문자로 쓴다
# 서버에서 compose.prod.yaml로 띄울 때만 쓴다
GITHUB_OWNER=likelion-backendschool-9th

# 배포할 이미지 태그 (커밋 SHA 등). 서버에서 compose.prod.yaml로 띄울 때만 쓴다
IMAGE_TAG=latest

# 로컬 HTTPS (docker compose --profile https)
HTTP_PORT=80
HTTPS_PORT=443

# 서버 배포 (compose.prod.yaml). TEAM_PORT는 서버에서 우리 팀에 배정된 포트(3005)
# 호스트 nginx가 도메인 요청을 127.0.0.1:TEAM_PORT로 넘긴다
COMPOSE_PROJECT_NAME=team5
TEAM_PORT=3005