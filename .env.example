# compose가 읽는 환경 변수 목록. 복사해서 값을 채운다: cp .env.example .env
# .env는 커밋하지 않는다

# DB (db, backend가 함께 읽는다)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 프론트 이미지를 빌드할 때 들어가는 접속 주소 (예: http://localhost:3005)
# compose.yaml, compose.override.yaml에서 쓴다
NEXT_PUBLIC_SITE_URL=

# 배포할 이미지 태그 (커밋 SHA 등). 서버에서 compose.prod.yaml로 띄울 때만 쓴다
IMAGE_TAG=
