# 복사해서 사용: cp .env.example .env   (.env는 절대 git에 올리지 말 것)

# ── 필수 ──
# 메인 백엔드와 공유하는 토큰. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
ANALYSIS_INTERNAL_TOKEN=
ANALYSIS_ANTHROPIC_API_KEY=

# Caddy가 인증서를 발급받을 도메인 (EC2 공인 IP를 가리키는 DNS A 레코드 필요)
DOMAIN=analysis.example.com

# ── 선택 (기본값 있음) ──
# ANALYSIS_ENVIRONMENT=local            # local | production
# ANALYSIS_LOG_LEVEL=INFO
# ANALYSIS_ENABLE_DOCS=true             # 로컬에서만 true 권장
# ANALYSIS_LABEL_MODEL=claude-haiku-5-5
# ANALYSIS_REASONING_MODEL=claude-sonnet-5-5
# ANALYSIS_LLM_CONCURRENCY=4
# ANALYSIS_LLM_TIMEOUT_SECONDS=180      # 리뷰 묶기는 리뷰가 많으면 오래 걸림
# ANALYSIS_LLM_MAX_RETRIES=3
# ANALYSIS_MAX_GROUPS=40
# ANALYSIS_GROUPING_MAX_TOKENS=8000     # 리뷰 묶기 응답 최대 길이. 리뷰가 수백 개면 늘릴 것
# ANALYSIS_PROMPT_SAMPLES_PER_GROUP=5
